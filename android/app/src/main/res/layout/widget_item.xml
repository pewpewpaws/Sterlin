<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_subject_card_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left Side: Subject Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Subject Type -->
        <TextView
            android:id="@+id/item_session_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject Type"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Subject Name (Code) -->
        <TextView
            android:id="@+id/item_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Subject Name (Code)"
            android:textColor="@color/widget_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Time Period + Teacher on the same line -->
        <TextView
            android:id="@+id/item_time_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Time Period · Teacher"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Hidden: teacher kept as separate ID for backwards-compat with widget code -->
        <TextView
            android:id="@+id/item_teacher"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
   </LinearLayout>

    <!-- Right Side: Plain-text attendance summary (no circle) -->
    <LinearLayout
        android:id="@+id/item_attendance_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_attendance_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textColor="@color/widget_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_attendance_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="17/20"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
   </LinearLayout>

</LinearLayout>
