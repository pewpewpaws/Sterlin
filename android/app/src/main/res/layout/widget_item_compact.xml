<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_subject_card_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Left Side: Subject Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Subject Type -->
        <TextView
            android:id="@+id/item_session_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lecture"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Subject Name (Code) -->
        <TextView
            android:id="@+id/item_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Subject Name (Code)"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Time Period -->
        <TextView
            android:id="@+id/item_time_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Time Period"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Professor Name -->
        <TextView
            android:id="@+id/item_teacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Professor name"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Right Side: Circular Progress Ring -->
    <LinearLayout
        android:id="@+id/item_attendance_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ProgressBar
                android:id="@+id/item_attendance_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_circular_progress_thick"
                android:progress="85" />

            <TextView
                android:id="@+id/item_attendance_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="85%"
                android:textColor="@color/widget_text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/item_attendance_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="17/20"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
